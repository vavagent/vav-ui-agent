# 依赖
node_modules/
.npm/

# Nuxt 构建产物
.nuxt/
.output/
dist/
.cache/

# 运行时数据库（首次启动由 server/database/index.ts 自动生成）
data/*.db
data/*.db-shm
data/*.db-wal
.data/

# 构建期生成的静态数据（由 scripts/make-catalog.mjs 从 seed-snapshot.json 产出）
public/catalog.json

# 备份与临时文件
*.bak
*.log
*.tmp

# 环境变量
.env
.env.*
!.env.example

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
